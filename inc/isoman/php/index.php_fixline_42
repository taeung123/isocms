function isoman_FileSizeConvert($bytes)
{
	$bytes = floatval($bytes);
	$arBytes = array(
		0 => array(
			"UNIT" => "TB",
			"VALUE" => pow(1024, 4)
		),
		1 => array(
			"UNIT" => "GB",
			"VALUE" => pow(1024, 3)
		),
		2 => array(
			"UNIT" => "MB",
			"VALUE" => pow(1024, 2)
		),
		3 => array(
			"UNIT" => "KB",
			"VALUE" => 1024
		),
		4 => array(
			"UNIT" => "B",
			"VALUE" => 1
		),
	);

	foreach ($arBytes as $arItem) {
		if ($bytes >= $arItem["VALUE"]) {
			$result = $bytes / $arItem["VALUE"];
			$result = floor($result) . " " . $arItem["UNIT"]; //str_replace(".", "," , strval(round($result, 2)))
			break;
		}
	}
	return $bytes == 0 ? '-' : $result;
}
function isoman_getfilesize($path)
{
	$filesize = filesize($path);
	return $filesize;
}
function isoman_getfoldersize($path)
{
	$total_size = 0;
	if (_isoman_ftp == 0) {
		$files = scandir($path);
		foreach ($files as $t) {
			if (is_dir(rtrim($path, '/') . '/' . $t)) {
				if ($t <> "." && $t <> "..") {
					$size = isoman_getfoldersize(rtrim($path, '/') . '/' . $t);

					$total_size += $size;
				}
			} else {
				$size = filesize(rtrim($path, '/') . '/' . $t);
				$total_size += $size;
			}
		}
	} else {
		return 0;
		$conn_id = ftp_connect(_isoman_ftp_host_info);
		$login_result = ftp_login($conn_id, _isoman_ftp_usr_info, _isoman_ftp_pwd_info);
		$files = ftp_nlist($conn_id, $path);
		foreach ($files as $t) {
			if (is_dir(rtrim($path, '/') . '/' . $t)) {
				if ($t <> "." && $t <> "..") {
					$size = isoman_getfoldersize(rtrim($path, '/') . '/' . $t);

					$total_size += $size;
				}
			} else {
				$size = ftp_size($conn_id, rtrim($path, '/') . '/' . $t);
				$total_size += $size;
			}
		}
	}
	return $total_size;
}
function default_isoman_upload_file()
{
	global $core, $_frontIsLoggedin_user_id, $datastore_folder, $clsISO;

	$currentDir = vnSessionGetVar("isoman_dir");
	$filename = '';

	if (isset($_POST) && $_SERVER['REQUEST_METHOD'] == "POST") {

		$list_files = $_FILES['attachments'];

		if (_isoman_ftp == 0) {
			// ====== Upload LOCAL ======
			if (!empty($list_files['name'])) {
				for ($i = 0; $i < count($list_files['name']); $i++) {

					$filezise = isoman_getfilesize($list_files['tmp_name'][$i]);
					if ($filezise < 100048576 && is_uploaded_file($list_files['tmp_name'][$i])) {

						$ftmp_name = $list_files['tmp_name'][$i];
						$fname = str_replace('&', '-', $list_files['name'][$i]);
						$fname = $clsISO->replaceSpaceFolder($fname);

						// Giới hạn tên file
						if (strlen($fname) > 180) {
							$tmpname = explode('.', $fname);
							$extension = array_pop($tmpname);
							$fname = substr(implode('.', $tmpname), 0, 180) . '.' . $extension;
						}

						// Đường dẫn file đích (WebP)
						$destination = preg_replace('/\.[^.]+$/', '.webp', $currentDir . "/" . $fname);

						if (!is_writable($currentDir)) {
							echo '_NOT_VALID';
							die();
						}

						$ext = strtolower(pathinfo($fname, PATHINFO_EXTENSION));
						if (in_array($ext, ['jpg', 'jpeg', 'png'])) {
							try {
								WebPConvert::convert($ftmp_name, $destination, [
									'quality' => 85,
									'max-quality' => 90,
									'metadata' => 'none'
								]);
								chmod($destination, 0777);
								$filename = $destination;
							} catch (Exception $e) {
								error_log('WebP conversion failed: ' . $e->getMessage());
							}
						} else {
							// Nếu không phải ảnh (vd: pdf, zip, ...), vẫn copy bình thường
							$destination = $currentDir . "/" . $fname;
							@copy($ftmp_name, $destination);
							chmod($destination, 0777);
							$filename = $destination;
						}
					}
				}
			}
		} else {
			// ====== Upload FTP ======
			if (!empty($list_files['name'])) {
				$conn_id = ftp_connect(_isoman_ftp_host_info);
				$login_result = ftp_login($conn_id, _isoman_ftp_usr_info, _isoman_ftp_pwd_info);
				$dir = str_replace(vnSessionGetVar("isoman_dir_root"), '', $currentDir);

				for ($i = 0; $i < count($list_files['name']); $i++) {
					$filezise = isoman_getfilesize($list_files['tmp_name'][$i]);
					if ($filezise < 5048576 && is_uploaded_file($list_files['tmp_name'][$i])) {

						$ftmp_name = $list_files['tmp_name'][$i];
						$fname = str_replace('&', '-', $list_files['name'][$i]);
						$fname = $clsISO->replaceSpaceFolder($fname);

						if (strlen($fname) > 180) {
							$tmpname = explode('.', $fname);
							$extension = array_pop($tmpname);
							$fname = substr(implode('.', $tmpname), 0, 180) . '.' . $extension;
						}

						$ext = strtolower(pathinfo($fname, PATHINFO_EXTENSION));
						$dir = str_replace('//', '', '/' . $dir);
						@ftp_chdir($conn_id, $dir);

						if (in_array($ext, ['jpg', 'jpeg', 'png'])) {
							// ✅ Chỉ tạo WebP, không upload file gốc
							$temp_webp = sys_get_temp_dir() . '/' . uniqid('webp_') . '.webp';
							try {
								WebPConvert::convert($ftmp_name, $temp_webp, [
									'quality' => 85,
									'max-quality' => 90,
									'metadata' => 'none'
								]);
								$remote_webp = preg_replace('/\.[^.]+$/', '.webp', $fname);
								ftp_put($conn_id, $remote_webp, $temp_webp, FTP_BINARY);
								ftp_chmod($conn_id, 0777, $remote_webp);
								@unlink($temp_webp);
								$filename = $currentDir . "/" . $remote_webp;
							} catch (Exception $e) {
								error_log('WebP conversion (FTP) failed: ' . $e->getMessage());
							}
						} else {
							// File không phải ảnh → upload gốc
							$filename = $currentDir . "/" . $fname;
							ftp_put($conn_id, $fname, $ftmp_name, FTP_BINARY);
							ftp_chmod($conn_id, 0777, $fname);
						}
					}
				}
				ftp_close($conn_id);
			}
		}
	}

	echo ($filename);
	die();
}

