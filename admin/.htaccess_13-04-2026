# /admin/.htaccess — Security patch

RewriteEngine On

# ============================================================
# [1] BLOCK HTTP METHOD NGUY HIỂM
# ============================================================
<LimitExcept GET POST>
    Require all denied
</LimitExcept>

# ============================================================
# [2] BLOCK TRUY CẬP TRỰC TIẾP FILE NHẠY CẢM
# ============================================================
<FilesMatch "\.(tpl|inc|cfg|log|sql|bak|backup|old|swp|tmp|env)$">
    Require all denied
</FilesMatch>

# Block file ẩn
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ============================================================
# [3] BLOCK TRUY CẬP TRỰC TIẾP THƯ MỤC NHẠY CẢM
# ============================================================
<IfModule mod_rewrite.c>
    # Block truy cập thẳng vào cache, logs, tmp, classes
    RewriteRule ^(cache|logs|tmp|classes)(/.*)?$ - [F,L,NC]

    # Block file PHP nguy hiểm ngoài index.php
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.php$
    RewriteCond %{REQUEST_URI} !^/admin/index\.php$
    RewriteRule ^ - [F,L]
</IfModule>

# ============================================================
# [4] SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

