# /cronjobs/.htaccess — Chỉ cho phép chạy từ CLI, block web access

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Cho phép nếu chạy từ CLI (không có HTTP_HOST)
    RewriteCond %{HTTP_HOST} .
    RewriteRule ^ - [F,L]
</IfModule>

# Fallback nếu mod_rewrite không có
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
