RewriteRule ^([a-z]{2})/cruise/(.*)/$													index.php?mod=cruise&act=cat2024&slug=$2&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/cruise/(.*)/&page=([0-9]*)$													index.php?mod=cruise&act=cat2024&slug=$2&page=$3&lang=$1 [QSA,L]
