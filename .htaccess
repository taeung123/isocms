#Rewrite Automatic by VietISO | Security patch: 07/2026
# ============================================================
# isoCMS ROOT .htaccess - isocms.com
# Comment: Tieng Viet khong dau
# ============================================================
SetEnv ISOCMS_DEBUG 0
SetEnv ISO_ENC_KEY "6d4ff0dd-8de9-4213-8667-37fd0096efb3"

RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/ - [L]
# ============================================================
# CANONICAL DOMAIN: CHI CHO PHEP ISOCMS.COM
# Phai dat truoc tat ca rule pass-through va module rewrite
# Lưu ý chỉ chạy đoạn fix domain cho product, nếu đang chạy sub domain thì off đoạn này
# ============================================================
RewriteCond %{HTTP_HOST} !^isocms\.com$ [NC]
RewriteRule ^ https://isocms.com%{REQUEST_URI} [R=301,L,NE]

# Ep HTTPS cho domain chinh
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://isocms.com%{REQUEST_URI} [R=301,L,NE]

# ============================================================
# [1] PASS-THROUGH FILE TINH - DAT DAU TIEN
# Check extension truc tiep tren URI - khong dung -f de tranh
# bi false khi co query string (?v=123) hoac path chua resolve

# tunel.php (Navicat HTTP Tunnel) - CHI CHO PHEP IP NOI BO / VPN
RewriteCond %{REQUEST_URI} ^/inc/tunel\.php$ [NC]
RewriteCond %{REMOTE_ADDR} !^(127\.0\.0\.1|124\.158\.4\.43)$
RewriteRule ^ - [F,L]
RewriteCond %{REQUEST_URI} ^/inc/tunel\.php$ [NC]
RewriteRule ^ - [L]
# ============================================================
# Pass-through file tinh: check THE_REQUEST de tranh match query string
# (vi du /files/thumb?src=pixel.png co .png trong query, khong phai URI that)
RewriteCond %{THE_REQUEST} \s[^\s?]*\.(css|js|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot|pdf|map|swf|mp4|mp3|ogg|webm|txt|json|zip|rar)[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/inc/timthumb/vietisothumb.php [NC]
RewriteCond %{REQUEST_URI} !^/inc/timthumb/vietisothumbwebp.php [NC]
RewriteCond %{REQUEST_URI} !^/files/thumbold/ [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumb.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumbwebp.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumbupdate.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumb.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumbwebp.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumbupdate.php [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/inc/editor/tinymce/ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/payment/ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/tunel.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/quocte_php/do.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/noidia_php/do.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/quocte_php/dr.php [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/noidia_php/dr.php [NC]
RewriteRule ^ - [L]

# ============================================================
# [2] BAO VE FILE NHAY CAM
# ============================================================
<FilesMatch "^(init|config|core|session_bootstrap)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "(\.env|\.git|\.gitignore|composer\.(json|lock)|package\.json|phpinfo\.php|readme\.(md|txt|html)|license\.(txt|md))$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(bak|sql|log|sh|swp|orig|dist|tmp|phar|phtml)$">
    Require all denied
</FilesMatch>

# Chan file backup theo pattern isoCMS (vi du: index.php_5-4-26, init.php_bk)
<FilesMatch "(_bk$|_bk\.|\.bk$|_[0-9]{1,2}-[0-9]{1,2}-[0-9]{2,4}$|_tam[0-9]*$)">
    Require all denied
</FilesMatch>

# Chan hnv.php - file khong con su dung
<FilesMatch "^hnv\.php$">
    Require all denied
</FilesMatch>

Options -Indexes

# Chan thu muc du lieu he thong
RewriteRule ^(logs|tmp|cache|json|ratelimit)(/.*)?$ - [F,L,NC]

# ============================================================
# [3] BLOCK PHP EXECUTION TRONG /uploads VA /files
# ============================================================
RewriteCond %{REQUEST_URI} ^/(uploads|files)/ [NC]
RewriteCond %{REQUEST_URI} \.(php|php3|php4|php5|phtml|phar|shtml|cgi|pl|py|sh|asp|aspx)$ [NC]
RewriteRule ^ - [F,L]

# ============================================================
# [4] BLOCK HTTP METHOD NGUY HIEM
# ============================================================
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT|DEBUG) [NC]
RewriteRule ^ - [F,L]

# ============================================================
# [5] BLOCK TAN CONG SQLi / XSS / PATH TRAVERSAL
# ============================================================
RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table|update.*set|delete.*from) [NC]
RewriteRule ^ - [F,L]

RewriteCond %{QUERY_STRING} (<script|javascript:|vbscript:|on(error|load|click|mouse)=) [NC]
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_URI} (\.\./|\.\.%2F|%2E%2E%2F|%2e%2e%2f) [NC]
RewriteRule ^ - [F,L]

RewriteCond %{QUERY_STRING} %00 [NC]
RewriteRule ^ - [F,L]

# ============================================================
# [6] SECURITY HEADERS
# ============================================================
RewriteRule ^(logs|tmp|cache|json|ratelimit)(/.*)?$ - [F,L,NC]
<IfModule mod_headers.c>
    Header unset ETag
    Header always unset X-Powered-By
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), fullscreen=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss: data: blob:; frame-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:;"
</IfModule>

# ============================================================
# [7] WHITELIST FILE PHP DUOC PHEP TRUY CAP TRUC TIEP
# ============================================================
<Files "index.php">
    Require all granted
</Files>

# Cho phep cac file he thong cu the
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumb\.php$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/timthumb/vietisothumbwebp\.php$ [NC]
RewriteRule ^ - [L]

# Thumb endpoints KHONG dung [L] o day - phai di den rule [15] de rewrite
# Chi bao Apache "dung block 403", khong dung rewrite
RewriteCond %{REQUEST_URI} ^/inc/editor/tinymce/ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/payment/ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/quocte_php/do\.php$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/noidia_php/do\.php$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/quocte_php/dr\.php$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/inc/onepaycredit/noidia_php/dr\.php$ [NC]
RewriteRule ^ - [L]



# ============================================================
# [8] WHITELIST FILE TECH QUA GATEWAY
# ============================================================
RewriteRule ^inc/tech/security-gateway\.php$ - [L]

RewriteCond %{REQUEST_URI} ^/inc/tech/.*\.php$ [NC]
RewriteCond %{REQUEST_URI} !security-gateway\.php$ [NC]
RewriteRule ^inc/tech/(.*\.php)$ /inc/tech/security-gateway.php?file=$1 [L,QSA]

# ============================================================
# [9] BLOCK TAT CA PHP KHAC (ngoai whitelist)
# ============================================================
# Thumb duoc goi dang /thumb?w=...&h=...&src=... (khong co .php trong URI)
RewriteRule ^thumb$ thumb.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} \.php$
RewriteCond %{REQUEST_URI} !^/(index|pagination_image|thumb)\.php$
RewriteCond %{REQUEST_URI} !^/files/thumb [NC]
RewriteCond %{REQUEST_URI} !^/inc/timthumb/ [NC]
RewriteRule ^ - [F,L]

# ============================================================
# [10] HTTPS REDIRECT
# Mac dinh: BAT SSL
# Neu site chua co SSL: comment 2 dong RewriteCond/RewriteRule bat SSL
# va bo comment 2 dong option tat SSL ben duoi
# ============================================================

# --- OPTION 1: BAT SSL (mac dinh) ---
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- OPTION 2: TAT SSL (site chua co chung chi) ---
# Bo comment 2 dong duoi, dong thoi comment lai option 1 phia tren
#RewriteCond %{HTTPS} on
##RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ============================================================
# [11] CANONICAL (chon 1, bo comment khi dung)
# ============================================================
# Bo www:
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L,NE]
# Them www:
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ============================================================
# [12] SEO: CHUAN HOA URL
# ============================================================
RewriteCond %{THE_REQUEST} ^GET.*index\.php [NC]
RewriteRule (.*?)index\.php/*(.*) /$1$2 [R=301,NE,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(.*)/index\.html$ /$1/ [R=301,L]

# ============================================================
# [13] CACHE + NEN
# Nang TTL CSS/JS len 1 nam - nen dung versioning hash khi deploy
# Vi du: style.css?v=20260511 hoac style.20260511.css
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.min\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    Header append Vary Accept-Encoding
    Header unset ETag
</IfModule>

FileETag None

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                  "access 1 hour"
    ExpiresByType text/css                   "access 1 year"
    ExpiresByType application/javascript     "access 1 year"
    ExpiresByType text/javascript            "access 1 year"
    ExpiresByType image/jpeg                 "access 1 year"
    ExpiresByType image/jpg                  "access 1 year"
    ExpiresByType image/png                  "access 1 year"
    ExpiresByType image/gif                  "access 1 year"
    ExpiresByType image/webp                 "access 1 year"
    ExpiresByType image/avif                 "access 1 year"
    ExpiresByType image/svg+xml              "access 1 year"
    ExpiresByType image/x-icon               "access 1 year"
    ExpiresByType font/woff                  "access 1 year"
    ExpiresByType font/woff2                 "access 1 year"
    ExpiresByType application/font-woff      "access 1 year"
    ExpiresByType application/font-woff2     "access 1 year"
    ExpiresByType application/x-font-ttf     "access 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ============================================================
# [14] ERROR DOCUMENTS
# ============================================================
ErrorDocument 404 /error.iso
ErrorDocument 403 /error.iso
ErrorDocument 500 /error.iso
RewriteRule ^error\.iso$ index.php?mod=unknow&lang=en [L]

# ============================================================
# [15] RESIZE IMAGE
# ============================================================
RewriteRule ^thumb-([0-9]*)-([0-9]*)-(.*)$ thumb.php?w=$1&h=$2&f=$3 [L]
RewriteRule ^files/thumb$                                             inc/timthumb/vietisothumb.php [L,QSA]
RewriteRule ^files/thumbwebp/([0-9]+)/([0-9]+)/(.+)$                 inc/timthumb/vietisothumbwebp.php?w=$1&h=$2&src=$3 [L]
RewriteRule ^files/thumbold/([0-9]+)/([0-9]+)/(.+)$                  inc/timthumb/vietisothumb.php?w=$1&h=$2&src=$3 [L]
RewriteRule ^inc/editor/tiny_mce/plugins/advimage/image\.htm$ admin/index.php?mod=editor&act=image [L]
RewriteRule ^xml_exchange_rate_vcb\.xml$ exchange_rate_vcb.php [QSA,L]

# ============================================================
# MODULE REWRITE RULES - GIU NGUYEN TU FILE GOC
# ============================================================

#- Mod API
RewriteRule ^api/tour/getAll.cfg$ 										index.php?mod=api&sub=tour&act=getAll&lang=vn [QSA,L]


RewriteRule ^api-login/okrs/user/login$ 									index.php?mod=api&sub=user&act=login [QSA,L]
RewriteRule ^api-login/okrs/user/delete$ 									index.php?mod=api&sub=user&act=delete [QSA,L]

#ticket
RewriteRule ^api/okrs/reply_ticket$ 									index.php?mod=api&sub=ticket&act=reply_ticket [QSA,L]
RewriteRule ^api/okrs/change_status_ticket$ 						index.php?mod=api&sub=ticket&act=change_status_ticket [QSA,L]
RewriteRule ^api/okrs/add_ticket$ 										index.php?mod=api&sub=ticket&act=add_ticket [QSA,L]


RewriteRule ^homenew$	index.php?mod=homenew&lang=vn [L]

RewriteRule ^$	index.php?mod=homepackage&lang=en [QSA,L]
RewriteRule ^/$	index.php?mod=homepackage&lang=en [QSA,L]

# Yeu cau chuyen ve ngon ngu mac dinh la "en" (17/4/2025)
#----------------// LANGUAGE EN //----------------/
RewriteRule ^login_new$	                            index.php?mod=member&act=signin4_new&noindex=noindex&lang=en [QSA,L]
RewriteRule ^signup_new$	                            index.php?mod=member&act=signup3_new&noindex=noindex&lang=en [QSA,L]

RewriteRule ^about/(.*).html$							index.php?mod=about&slug=$1&lang=en [L]
RewriteRule ^contact-us.html$							index.php?mod=tour_new&act=contact&lang=en [L]
RewriteRule ^about-us.html$							    index.php?mod=about&act=about&lang=en [L]
RewriteRule ^faqs.html$									index.php?mod=faqs&lang=en [L]
RewriteRule ^why-travel-with-us.html$					index.php?mod=about&act=why&show=Why&lang=en [L]
RewriteRule ^our-team.html$								index.php?mod=about&act=team&lang=en [L]
RewriteRule ^brochure.html$								index.php?mod=about&act=brochure&lang=en [L]

#-- Mod News.
RewriteRule ^travel-news$ 								index.php?mod=news&lang=en [L]
RewriteRule ^n([0-9]*)-(.*).html$					index.php?mod=news&act=detail&news_id=$1&slug=$2&lang=en [L]
RewriteRule ^travel-news&page=([0-9]*)$ 				index.php?mod=news&page=$1&lang=en [L]
RewriteRule ^travel-news/(.*)$ 							index.php?mod=news&slug=$1&show=cat&lang=en [L]
RewriteRule ^travel-news/(.*)&page=([0-9]*)$ 			index.php?mod=news&slug=$1&page=$2&show=cat&lang=en [L]

#- Mod Testimonial.
RewriteRule ^testimonials$								index.php?mod=testimonial&lang=en [L]
RewriteRule ^testimonials/&page=([0-9]*)$				index.php?mod=testimonial&page=$1&lang=en [L]
RewriteRule ^te([0-9]*)-(.*).html$					index.php?mod=testimonial&act=detail&testimonial_id=$1&slug=$2&lang=en [L]

#-- Mod Service.
RewriteRule ^travel-services$							index.php?mod=service&lang=en [L]
RewriteRule ^travel-services&page=([0-9]*)$				index.php?mod=service&page=$1&lang=en [L]
RewriteRule ^s([0-9]*)-(.*).html$					index.php?mod=service&act=detail&service_id=$1&slug=$2&lang=en [L]

RewriteRule ^book-service/([0-9]*)$					  	index.php?mod=about&act=contact&service_id=$1&show=service&lang=en [L]
RewriteRule ^travel-services/(.*)$ 									index.php?mod=service&slug=$1&show=cat&lang=en [L]
RewriteRule ^travel-services/(.*)&page=([0-9]*)$ 					index.php?mod=service&slug=$1&page=$2&show=cat&lang=en [L]

#- voucher
RewriteRule ^voucher.html$								index.php?mod=voucher&lang=en [QSA,L]
RewriteRule ^voucher&page=([0-9]*)$						index.php?mod=voucher&page=$1&lang=en [L]
RewriteRule ^tim-kiem-voucher/(.*)$						index.php?mod=voucher&act=searchvoucher&cond=$1&lang=en [L]
RewriteRule ^v([0-9]*)-(.*).html$						index.php?mod=voucher&act=detail&voucher_id=$1&slug=$2&lang=en [L]

#InBound
RewriteRule ^inbound-tours/(.*)$ 		 			index.php?mod=tour&act=place_inbound2024&slug_city=$1&show=City&lang=en [QSA,L]
RewriteRule ^inbound-tours/(.*)&page=([0-9]*)$ 	    index.php?mod=tour&act=place_inbound2024&slug_city=$1&page=$2&show=City&lang=en [QSA,L]

#-- Mod Destinations.
RewriteRule ^destinations/(.*)/(.*)/(.*).html$       index.php?mod=guide&act=cat&slug_country=$1&slug_city=$2&slug_guidecat=$3&show=City&lang=en [L]
RewriteRule ^destinations/(.*)/(.*)$                 index.php?mod=destination&act=place&slug_country=$1&slug_city=$2&show=City&lang=en [QSA,L]
RewriteRule ^destinations/(.*)/(.*)&page=([0-9]*)$ 	index.php?mod=destination&act=place&slug_country=$1&slug_city=$2&page=$3&show=City&lang=en [QSA,L]
RewriteRule ^destinations/(.*)$ 			            index.php?mod=destination&act=place&slug_country=$1&show=Country&lang=en [QSA,L]
RewriteRule ^destinations/(.*)&page=([0-9]*)$ 	    index.php?mod=destination&act=place&slug_country=$1&page=$2&show=Country&lang=en [QSA,L]

#-- Mod Travel Guide
RewriteRule ^travel-guide$						    index.php?mod=guide&act=default&lang=en [QSA,L]
RewriteRule ^travel-guide&page=([0-9]*)$			    index.php?mod=guide&act=default&page=$1&lang=en [QSA,L]
RewriteRule ^travel-guide/(.*)$			            index.php?mod=guide&act=default&slug_country=$1&lang=en [QSA,L]
RewriteRule ^destination/(.*)/travel-guide$			            index.php?mod=guide&act=default&slug_country=$1&lang=en [QSA,L]
RewriteRule ^destination/(.*)/travel-guide&page=([0-9]*)$			    index.php?mod=guide&act=default&slug_country=$1&page=$2&lang=en [L,QSA]

#-- Mod Destination (Hnv)
RewriteRule ^destination/(.*)/(.*)-c([0-9]*)$ 			            index.php?mod=tour&act=travel_style_by_country&slug_country=$1&slug=$2&cat_id=$3&show=CatCountry&lang=en [QSA,L]
RewriteRule ^destination/(.*)$ 			            index.php?mod=destination&act=place2&slug_country=$1&show=Country&lang=en [QSA,L]
#-- Mod tour (Hnv)
RewriteRule ^tour/(.*)$ 			                    index.php?mod=destination&act=place&slug_country=$1&show=Country&lang=en [QSA,L]
RewriteRule ^tour/(.*)&page=([0-9]*)$ 	            index.php?mod=destination&act=place&slug_country=$1&page=$2&show=Country&lang=en [QSA,L]
#-- Mod Blog.
RewriteRule ^b([0-9]*)-(.*).html$					index.php?mod=blog&act=detail&blog_id=$1&slug=$2&lang=en [L]
RewriteRule ^blog/tag/(.*)/&page=([0-9]*)$ 				index.php?mod=blog&act=tag&slug=$1&page=$2&show=tag&lang=en [L]
RewriteRule ^blog/tag/(.*)$ 							index.php?mod=blog&act=tag&slug=$1&show=tag&lang=en [L]
RewriteRule ^blog/&page=([0-9]*)$ 						index.php?mod=blog&page=$1&show=Default&lang=en [L]
RewriteRule ^blog$ 										index.php?mod=blog&show=Default&lang=en [L,QSA]
RewriteRule ^blog/(.*).html&page=([0-9]*)$				index.php?mod=blog&act=cat&slug_cat=$1&page=$2&show=Cat&lang=en [L]
RewriteRule ^blog/(.*).html$ 							index.php?mod=blog&act=cat&slug_cat=$1&show=Cat&lang=en [L]
RewriteRule ^blog/(.*)/(.*)/&page=([0-9]*)$ 			index.php?mod=blog&slug_country=$1&slug_city=$2&page=$3&show=City&lang=en [L]
RewriteRule ^blog/(.*)/&page=([0-9]*)$ 					index.php?mod=blog&slug_country=$1&page=$2&show=Country&lang=en [L]
RewriteRule ^blog/(.*)/(.*)-rg([0-9]*)$ 				index.php?mod=blog&slug_country=$1&slug_region=$2&region_id=$3&show=Region&lang=en [L]
RewriteRule ^blog/(.*)/(.*)$ 							index.php?mod=blog&slug_country=$1&slug_city=$2&show=City&lang=en [L]
RewriteRule ^blog/(.*)$ 								index.php?mod=blog&slug_country=$1&show=Country&lang=en [L]

#
RewriteRule ^tours/(.*)-c([0-9]*)/(.*)$					index.php?mod=tour&act=cat&slug=$1&cat_id=$2&slug_country=$3&show=CatCountry&lang=en [QSA,L]
RewriteRule ^tours/(.*)-c([0-9]*)&page=([0-9]*)$		index.php?mod=tour&act=cat2024&slug=$1&cat_id=$2&page=$3&show=Category&lang=en [QSA,L]
RewriteRule ^tours/(.*)-c([0-9]*)$						index.php?mod=tour&act=cat2024&slug=$1&cat_id=$2&show=Category&lang=en [QSA,L]

RewriteRule ^t([0-9]*)-(.*).html$					    index.php?mod=tour_new&act=detaildeparture2024&tour_id=$1&slug=$2&lang=en [L]

RewriteRule ^cruise/enquiry.html$					    index.php?mod=about&act=contact2&show=CRUISE&lang=en [L]

RewriteRule ^tour/enquiry/(.*).html$ 					index.php?mod=tailor&act=customize&slug=$1&show=Tour&lang=en [L]
RewriteRule ^tours$ 						        index.php?mod=tour&act=searchtour2024&cond=$1&lang=en [QSA,L]
RewriteRule ^tours&page=([0-9]*)$ 				index.php?mod=tour&act=searchtour2024&page=$1&lang=en [QSA,L]
#- Mod Cart.
RewriteRule ^shopping-cart$								index.php?mod=cart&act=cart&noindex=noindex&lang=en [L]
RewriteRule ^cart$								        index.php?mod=cart&act=cart&noindex=noindex&lang=en [L]
RewriteRule ^shopping-cart/booking.html$				index.php?mod=cart&act=book_2024&noindex=noindex&lang=en [L]

#-- Mod Hotel.
RewriteRule ^hotels/$					            index.php?mod=hotel&act=place2024&lang=en [QSA,L]
RewriteRule ^hotels/&page=([0-9]*)$					index.php?mod=hotel&act=place2024&page=$1&lang=en [QSA,L]
