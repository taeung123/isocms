RewriteRule ^([a-z]{2})/blog/tag/(.*)/&page=([0-9]*)$ 				index.php?mod=blog&act=tag&slug=$2&page=$3&show=tag&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/tag/(.*)$ 							index.php?mod=blog&act=tag&slug=$2&show=tag&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/&page=([0-9]*)$ 						index.php?mod=blog&page=$2&show=Default&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog$ 										index.php?mod=blog&show=Default&lang=$1 [L,QSA]

RewriteRule ^([a-z]{2})/blog/(.*).html&page=([0-9]*)$				index.php?mod=blog&act=cat&slug_cat=$2&page=$3&show=Cat&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*).html$ 							index.php?mod=blog&act=cat&slug_cat=$2&show=Cat&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*)/(.*)/&page=([0-9]*)$ 			index.php?mod=blog&slug_country=$2&slug_city=$3&page=$4&show=City&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*)/&page=([0-9]*)$ 					index.php?mod=blog&slug_country=$2&page=$3&show=Country&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*)/(.*)-rg([0-9]*)$ 				index.php?mod=blog&slug_country=$2&slug_region=$3&region_id=$4&show=Region&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*)/(.*)$ 							index.php?mod=blog&slug_country=$2&slug_city=$3&show=City&lang=$1 [L]
RewriteRule ^([a-z]{2})/blog/(.*)$ 								index.php?mod=blog&slug_country=$2&show=Country&lang=$1 [L]

RewriteRule ^([a-z]{2})/tours/(.*)-c([0-9]*)/(.*)$					index.php?mod=tour&act=cat&slug=$2&cat_id=$3&slug_country=$4&show=CatCountry&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/tours/(.*)-c([0-9]*)&page=([0-9]*)$			index.php?mod=tour&act=cat2024&slug=$2&cat_id=$3&page=$4&show=Category&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/tours/(.*)-c([0-9]*)$						index.php?mod=tour&act=cat2024&slug=$2&cat_id=$3&show=Category&lang=$1 [QSA,L]

RewriteRule ^([a-z]{2})/t([0-9]*)-(.*).html$					    index.php?mod=tour_new&act=detaildeparture2024&tour_id=$2&slug=$3&lang=$1 [L]

RewriteRule ^([a-z]{2})/cruise/enquiry.html$					    index.php?mod=about&act=contact2&show=CRUISE&lang=$1 [L]

RewriteRule ^([a-z]{2})/tour/enquiry/(.*).html$ 					index.php?mod=tailor&act=customize&slug=$2&show=Tour&lang=$1 [L]
RewriteRule ^([a-z]{2})/tours$ 						        index.php?mod=tour&act=searchtour2024&cond=$2&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/tours&page=([0-9]*)$ 				index.php?mod=tour&act=searchtour2024&page=$2&lang=$1 [QSA,L]

#- Mod Cart.
RewriteRule ^([a-z]{2})/shopping-cart$								index.php?mod=cart&act=cart&noindex=noindex&lang=$1 [L]
RewriteRule ^([a-z]{2})/cart$								        index.php?mod=cart&act=cart&noindex=noindex&lang=$1 [L]
RewriteRule ^([a-z]{2})/shopping-cart/booking.html$				    index.php?mod=cart&act=book_2024&noindex=noindex&lang=$1 [L]

#-- Mod Hotel.
RewriteRule ^([a-z]{2})/hotels/$					            index.php?mod=hotel&act=place2024&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/hotels/&page=([0-9]*)$					index.php?mod=hotel&act=place2024&page=$2&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/hotels/(.*)&page=([0-9]*)$				index.php?mod=hotel&act=place2024&slug_country=$2&page=$3&show=Country&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/hotels/(.*)$							index.php?mod=hotel&act=place2024&slug_country=$2&show=Country&lang=$1 [QSA,L]

RewriteRule ^([a-z]{2})/h([0-9]*)-(.*).html$					index.php?mod=hotel&act=detail2024&hotel_id=$2&slug=$3&lang=$1 [L]
RewriteRule ^([a-z]{2})/hotels/(.*)/booking.html$				index.php?mod=hotel&act=book&slug=$2&lang=$1 [L]
RewriteRule ^([a-z]{2})/hotels(.*)&page=([0-9]*)$				index.php?mod=hotel&slug_country=$2&page=$3&lang=$1 [L]
RewriteRule ^([a-z]{2})/hotels/(.*)-h([0-9]*).html$				index.php?mod=hotel&act=detail&slug=$2&hotel_id=$3&lang=$1 [L]
RewriteRule ^([a-z]{2})/hotels/(.*)/(.*)-rg([0-9]*)$				index.php?mod=hotel&act=place&slug_country=$2&slug_region=$3&region_id=$4&show=Region&lang=$1 [L]
RewriteRule ^([a-z]{2})/hotels/(.*)/(.*)$						index.php?mod=hotel&act=place&slug_country=$2&slug_city=$3&show=City&lang=$1 [L]
RewriteRule ^([a-z]{2})/search-hotels/(.*)$ 					index.php?mod=hotel&act=search&cond=$2&lang=$1 [L]

#-- Mod Cruise.
RewriteRule ^([a-z]{2})/cruise/(.*)-c([0-9]*)/bookingcabin.html$		index.php?mod=cruise&act=bookcabin&slug=$2&cruise_id=$3&lang=$1 [L]
RewriteRule ^([a-z]{2})/cruise/$									index.php?mod=cruise&act=search2024&lang=$1 [QSA,L]
RewriteRule ^([a-z]{2})/cruise/&page=([0-9]*)$									index.php?mod=cruise&act=search2024&page=$2&lang=$1 [QSA,L]
