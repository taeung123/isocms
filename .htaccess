RewriteRule ^([a-z]{2})/account/wishlist.html$		            	index.php?mod=member&act=my_wishlist&lang=$1 [L]
RewriteRule ^([a-z]{2})/account/my-profile/contact-info.html$		    index.php?mod=member&act=contact_info&lang=$1 [L]
