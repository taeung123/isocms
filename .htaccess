RewriteRule ^([a-z]{2})/oauth2callback$							index.php?mod=member&act=callback&lang=$1 [L]
RewriteRule ^([a-z]{2})/account/signup.html$		                index.php?mod=member&act=signup2&lang=$1 [L]
