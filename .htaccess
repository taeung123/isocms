RewriteRule ^([a-z]{2})/cruise/(.*)/([0-9]*)-day.html$				index.php?mod=cruise&act=detail&slug=$2&day=$3&show=Itinerary&lang=$1 [L]
RewriteRule ^([a-z]{2})/cruise/(.*).html$							index.php?mod=cruise&act=detail&slug=$2&lang=$1 [L]

RewriteRule ^([a-z]{2})/c([0-9]*)-(.*).html$					index.php?mod=cruise&act=detail&cruise_id=$2&slug=$3&lang=$1 [L]
RewriteRule ^([a-z]{2})/new-c([0-9]*)-(.*).html$					index.php?mod=cruise&act=detail2024&cruise_id=$2&slug=$3&lang=$1 [L]

RewriteRule ^([a-z]{2})/search-cruises/(.*)$						index.php?mod=cruise&act=search&cond=$2&lang=$1 [L]

#- Successful
RewriteRule ^([a-z]{2})/booking/booking_id=([0-9]*)&successful$ 					index.php?mod=cart&act=success&show=bookTour&booking_id=$2&lang=$1 [L]
